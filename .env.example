# Copy this file to `.env` and fill in your own values, then restart `npm run dev`.

# PayPal client id used to render the checkout buttons on the Pricing section.
# Get one at https://developer.paypal.com/dashboard/applications (use a "Live" app id
# for real payments, or leave unset to fall back to the public "sb" sandbox id for testing).
VITE_PAYPAL_CLIENT_ID=

# EmailJS credentials used by the Contact form to deliver messages straight to
# zxwytweaking@gmail.com as a real email (no backend required). One-time setup:
#   1. Create a free account at https://www.emailjs.com and log in.
#   2. Email Services -> Add New Service -> connect Gmail (or any provider) and log in as
#      zxwytweaking@gmail.com. Copy the generated "Service ID" into VITE_EMAILJS_SERVICE_ID.
#   3. Email Templates -> Create New Template. Set "To email" to zxwytweaking@gmail.com,
#      and use {{from_name}}, {{reply_to}}, {{message}} in the subject/body (these are the
#      exact variable names the form sends). Copy the "Template ID" into VITE_EMAILJS_TEMPLATE_ID.
#   4. Account -> General -> copy the "Public Key" into VITE_EMAILJS_PUBLIC_KEY.
#   5. Save this file as `.env` in the project root and restart `npm run dev` (or rebuild).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
